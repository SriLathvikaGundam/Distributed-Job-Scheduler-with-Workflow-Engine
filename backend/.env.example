PORT=3000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/job_scheduler?appName=Cluster0
POLL_INTERVAL_MS=1000
LEASE_MS=30000
JOB_TIMEOUT_MS=20000
SCHEDULER_TICK_MS=1000
QUEUE_MODE=mongo
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/job-scheduler-jobs